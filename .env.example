# ---- Discord ----
# 從 Discord Developer Portal (https://discord.com/developers/applications) 取得。
#
# 注意：DISCORD_TOKEN / DISCORD_KTV_CHANNEL_ID 現為「初始種子」。
# 首次啟動時若 Redis 尚無設定 (ktv:config:discord)，bot 會把這裡的值寫入 Redis 當初始值；
# 之後可於網頁（右側欄「Discord 設定」）變更 token / channelId，bot 會在同一 process 熱重連，
# 設定持久化於 Redis。留空 DISCORD_TOKEN 也可啟動：bot 進入待命，等待網頁設定後自動連線。
DISCORD_TOKEN=your-discord-bot-token
# 可選：限制 bot 只在特定頻道回應點歌（純數字 channel id；留空表示所有可見頻道）
DISCORD_KTV_CHANNEL_ID=

# ---- Redis ----
# 開發用 docker-compose 會覆寫為 redis://redis:6379
REDIS_URL=redis://localhost:6379

# ---- API (Express + WebSocket) ----
API_PORT=3333
# WebSocket 與 REST 皆掛在同一個 port
# all-in-one image 中，API 會以 static 提供 web 產物
# 允許的 CORS 來源（逗號分隔）。開發時前端在 :4200 與 API :3333 跨來源，需放行。
# all-in-one 同源部署可留空字串停用 CORS。
CORS_ORIGIN=http://localhost:4200

# ---- Web (React 前端 / Vite) ----
# 前端連線 API 的 base URL 與 WebSocket URL
VITE_API_URL=http://localhost:3333
VITE_WS_URL=ws://localhost:3333
WEB_PORT=4200
