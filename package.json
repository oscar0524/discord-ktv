{
  "name": "@discord-ktv/source",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "透過 Discord 貼 YouTube 連結點歌，單一大螢幕自動播放的 KTV 系統 (Nx monorepo)",
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "serve:bot": "nx serve discord-bot",
    "serve:api": "nx serve api",
    "serve:web": "nx serve web",
    "graph": "nx graph",
    "docker:build": "scripts/docker-build.sh",
    "docker:build:amd64": "PLATFORM=linux/amd64 scripts/docker-build.sh",
    "docker:build:arm64": "PLATFORM=linux/arm64 scripts/docker-build.sh"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "discord.js": "^14.16.3",
    "express": "^4.21.1",
    "ioredis": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "youtube-player": "^5.6.0"
  },
  "devDependencies": {
    "@nx/js": "20.3.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.13",
    "@types/youtube-player": "^5.5.11",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.24.2",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nx": "20.3.0",
    "postcss": "^8.5.28",
    "prettier": "^3.3.3",
    "sass": "^1.104.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.3.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.21"
  }
}
