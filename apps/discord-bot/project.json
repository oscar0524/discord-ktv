{
  "name": "discord-bot",
  "sourceRoot": "apps/discord-bot/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/discord-bot"],
      "options": {
        "command": "esbuild apps/discord-bot/src/main.ts --bundle --platform=node --target=node20 --format=cjs --sourcemap --tsconfig=apps/discord-bot/tsconfig.json --outfile=dist/apps/discord-bot/main.js",
        "cwd": "."
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register apps/discord-bot/src/main.ts",
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/discord-bot/tsconfig.json",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config apps/discord-bot/jest.config.ts",
        "cwd": "."
      }
    }
  },
  "tags": ["scope:bot", "type:app"]
}
