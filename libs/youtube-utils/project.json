{
  "name": "youtube-utils",
  "sourceRoot": "libs/youtube-utils/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/youtube-utils/tsconfig.json",
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/youtube-utils/tsconfig.json --noEmit",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config libs/youtube-utils/jest.config.ts",
        "cwd": "."
      }
    }
  },
  "tags": ["scope:shared", "type:util"]
}
